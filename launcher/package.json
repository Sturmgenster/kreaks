{
  "name": "kreaks-launcher",
  "productName": "KREAKS Launcher",
  "version": "1.0.0",
  "description": "Launcher für KREAKS",
  "main": "src/main.js",
  "author": "Jonas Tim Hoppe",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "release-game": "node tools/release-game.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "de.kreaks.launcher",
    "productName": "KREAKS Launcher",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/bundled-game/**",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "KREAKS",
      "artifactName": "KREAKS-Launcher-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://raw.githubusercontent.com/Sturmgenster/kreaks/main/launcher-update/"
      }
    ],
    "compression": "maximum"
  }
}